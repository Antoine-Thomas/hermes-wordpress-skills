# Hermes WordPress Skills - variables d'environnement
# Copier ce fichier vers .env et renseigner vos valeurs

# --- Local by Flywheel ---
# Chemin du dossier des sites Local (defaut: ~/Local Sites)
LOCAL_SITES_PATH=~/Local Sites

# --- WP-CLI ---
# Chemin vers l'executable WP-CLI (defaut: wp)
WP_CLI_PATH=wp

# --- Valeurs par defaut des nouveaux sites ---
DEFAULT_PHP_VERSION=8.2
DEFAULT_WP_VERSION=latest
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_EMAIL=admin@example.com

# --- Base de donnees locale ---
DEFAULT_DB_NAME=local
DEFAULT_DB_USER=root
DEFAULT_DB_PASSWORD=root
DEFAULT_DB_HOST=localhost

# --- Deploiement FTP ---
FTP_HOST=ftp.example.com
FTP_PORT=21
FTP_USER=your_ftp_user
FTP_PASSWORD=your_ftp_password
FTP_REMOTE_PATH=/public_html

# --- Deploiement SSH ---
SSH_HOST=user@your-server.com
SSH_PORT=22
SSH_KEY_PATH=~/.ssh/id_rsa
SSH_REMOTE_PATH=/var/www/html

# --- Sauvegardes ---
BACKUP_OUTPUT_DIR=./backups
BACKUP_COMPRESS=true

# --- URL de production (search-replace) ---
PRODUCTION_URL=https://example.com
